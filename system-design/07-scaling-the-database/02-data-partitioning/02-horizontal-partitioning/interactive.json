    "validationRules": [
      {
        "type": "required_node",
        "nodeType": "shard_router",
        "message": "Include a shard router so requests can be routed to the correct shard based on the sharding key (e.g., user_id)."
      },
      {
        "type": "min_count",
        "nodeType": "api_service",
        "count": 1,
        "message": "Add an API Service between the client and the sharding layer to represent the application issuing queries."
      },
      {
        "type": "required_node",
        "nodeType": "shard_key_map",
        "message": "Add a shard key map/config component to represent how the system knows which user_id range/hash goes to which shard."
      },
      {
        "type": "min_count",
        "nodeType": "shard_1_db",
        "count": 1,
        "message": "Add at least one shard database (Shard 1) to demonstrate horizontal partitioning across servers."
      },
      {
        "type": "min_count",
        "nodeType": "shard_2_db",
        "count": 1,
        "message": "Add at least a second shard database (Shard 2) to show the table is split by rows across multiple servers."
      },
      {
        "type": "path_exists",
        "from": "client_app",
        "to": "shard_1_db",
        "message": "Ensure the client can reach Shard 1 via the API and shard router; clients should not talk to shards directly."
      },
      {
        "type": "path_exists",
        "from": "client_app",
        "to": "shard_2_db",
        "message": "Ensure the client can reach Shard 2 via the API and shard router; sharding enables scaling by adding more shard servers."
      },
      {
        "type": "no_direct_edge",
        "from": "api_service",
        "to": "shard_1_db",
        "message": "Avoid connecting the API directly to a shard DB; route through the shard router to keep shard selection logic centralized."
      },
      {
        "type": "no_direct_edge",
        "from": "api_service",
        "to": "shard_2_db",
        "message": "Avoid connecting the API directly to a shard DB; the shard router should decide the correct shard based on user_id."
      }
    ],
