      },
      {
        "type": "required_node",
        "nodeType": "quorum_router",
        "message": "Include a quorum/consensus layer to make partition-aware decisions (e.g., require majority for writes) instead of letting isolated nodes accept conflicting writes."
      },
      {
        "type": "min_count",
        "nodeType": "replica_db",
        "count": 1,
        "message": "Add at least one replica to represent multi-node storage where partitions can cause divergence if not managed."
