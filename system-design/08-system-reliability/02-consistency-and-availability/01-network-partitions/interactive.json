        "type": "path_exists",
        "from": "client",
        "to": "primary_db",
        "message": "Ensure there is a request path from the client to the primary database (through the load balancer and app) so the system can serve consistent reads/writes when quorum is available."
      },
      {
        "type": "no_direct_edge",
        "from": "app_service",
        "to": "primary_db",
        "message": "Do not connect the app directly to the primary DB. Route through the quorum/consensus layer so writes can be rejected or fenced during a partition."
      },
      {
        "type": "no_direct_edge",
        "from": "app_service",
        "to": "replica_db",
        "message": "Do not connect the app directly to replicas. Reads/writes must be mediated by quorum rules to avoid serving unsafe results during partitions."
      }
