    "validationRules": [
      {
        "type": "required_node",
        "nodeType": "api_gateway",
        "message": "Add an API Gateway so there is a clear entry point where requests first enter the system (a common place to start a trace)."
      },
      {
        "type": "min_count",
        "nodeType": "service_a",
        "count": 1,
        "message": "Include Service A as the first backend hop so the trace has at least one service span beyond the gateway."
      },
      {
        "type": "min_count",
        "nodeType": "service_b",
        "count": 1,
        "message": "Include Service B to show a multi-hop distributed request (traces are most valuable when requests cross service boundaries)."
      },
      {
        "type": "min_count",
        "nodeType": "service_c",
        "count": 1,
        "message": "Include Service C to make the request path long enough to reveal latency and dependency chains."
      },
      {
        "type": "path_exists",
        "from": "client",
        "to": "service_c",
        "message": "Ensure the request can flow from Client all the way to Service C through the system so the trace represents an end-to-end journey."
      },
      {
        "type": "required_node",
        "nodeType": "tracing_collector",
        "message": "Add a Tracing Collector to receive spans from services; without it, traces can't be assembled across components."
      },
      {
        "type": "min_connections",
        "nodeType": "tracing_collector",
        "count": 4,
        "message": "Connect the Tracing Collector to all three services and to Trace Storage so it can aggregate spans and persist completed traces."
      },
      {
        "type": "no_direct_edge",
        "from": "client",
        "to": "service_a",
        "message": "Do not connect Client directly to Service A. Requests should enter through the API Gateway to keep the trace entry point consistent."
      }
    ],
