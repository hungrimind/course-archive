    "validationRules": [
      {
        "type": "required_node",
        "nodeType": "secret_manager",
        "message": "Add a Secret Manager to securely store and broker access to secrets (avoid hardcoding secrets in services)."
      },
      {
        "type": "required_edge",
        "from": "service",
        "to": "secret_manager",
        "message": "The Service should fetch secrets from the Secret Manager, not from a raw secret store."
      },
      {
        "type": "required_edge",
        "from": "secret_manager",
        "to": "secret",
        "message": "The Secret Manager must be connected to the Secret so it can store/retrieve the sensitive value."
      },
      {
        "type": "no_direct_edge",
        "from": "service",
        "to": "secret",
        "message": "Avoid connecting the Service directly to the Secret. This models risky patterns like embedding secrets in configs or accessing a secret store without controls."
      },
      {
        "type": "path_exists",
        "from": "rotation_job",
        "to": "secret",
        "message": "Include a rotation path so secrets can be regularly rotated, reducing impact if a secret is compromised."
      },
      {
        "type": "required_edge",
        "from": "secret_manager",
        "to": "audit_logs",
        "message": "Send Secret Manager access events to Audit Logs so secret reads/changes can be monitored and investigated."
      }
    ],
